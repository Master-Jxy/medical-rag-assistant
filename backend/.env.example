# 真实密钥只填写在本地 .env 中，不要提交到 Git。
DASHSCOPE_API_KEY=your_dashscope_api_key_here
CHAT_MODEL_NAME=qwen3-max
CHAT_INPUT_PRICE_PER_MILLION_TOKENS_CNY=2.5
CHAT_OUTPUT_PRICE_PER_MILLION_TOKENS_CNY=10
MEMORY_AUTO_EXTRACTION_ENABLED=false
MEMORY_EXTRACTION_INTERVAL_TURNS=3
MEMORY_RAG_MAX_ITEMS=4
MEMORY_AGENT_MAX_ITEMS=6
QUOTA_POLICY_MODE=off
# 旧开关仅保留一个发布周期；QUOTA_POLICY_MODE存在时以新配置为准。
QUOTA_ENFORCEMENT_ENABLED=false
DEFAULT_QUOTA_PLAN_CODE=free
QUOTA_RAG_RESERVE_TOKENS=4000
QUOTA_AGENT_RESERVE_TOKENS=12000
QUOTA_RAG_MAX_OUTPUT_TOKENS=2000
QUOTA_RAG_SOURCE_WRAPPER_TOKENS=200
EMBEDDING_MODEL_NAME=text-embedding-v4
DASHSCOPE_MAX_RETRIES=2
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=agent
UPLOAD_DIR=./data
DOCUMENT_REGISTRY_PATH=./data/documents.json
KNOWLEDGE_BASE_VERSION=live_v1
MAX_UPLOAD_SIZE_BYTES=10485760
CHUNK_SIZE=800
CHUNK_OVERLAP=100
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DATABASE_URL=mysql+pymysql://medical_rag_user:change_me@127.0.0.1:3306/medical_rag?charset=utf8mb4
REDIS_URL=
REDIS_CONNECT_TIMEOUT_SECONDS=0.5
REDIS_SOCKET_TIMEOUT_SECONDS=0.5
AUTH_REGISTER_RATE_LIMIT=5
AUTH_REGISTER_RATE_WINDOW_SECONDS=600
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_WINDOW_SECONDS=300
CHAT_RATE_LIMIT=10
CHAT_RATE_WINDOW_SECONDS=60
UPLOAD_RATE_LIMIT=5
UPLOAD_RATE_WINDOW_SECONDS=3600
UPLOAD_CONCURRENCY_LIMIT=1
UPLOAD_CONCURRENCY_TTL_SECONDS=600
GENERATION_LOCK_TTL_SECONDS=600
IDEMPOTENCY_IN_PROGRESS_TTL_SECONDS=600
IDEMPOTENCY_RESULT_TTL_SECONDS=86400
AUTH_RATE_LIMIT_FALLBACK_MAX_KEYS=4096
TRUSTED_PROXY_IPS=[]
JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_characters_long
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=example@qq.com
SMTP_PASSWORD=replace_with_qq_smtp_authorization_code
SMTP_USE_SSL=true
SMTP_TIMEOUT_SECONDS=10
MAIL_FROM_NAME=医疗知识库助手
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5
MAX_HISTORY_ROUNDS=3
MAX_HISTORY_CHARS=6000
# 默认不启用相关度阈值；启用示例：RAG_MIN_RELEVANCE_SCORE=0.70
RAG_FILTER_DEPARTMENT=
RAG_FILTER_TOPIC=
RAG_FILTER_DOCUMENT_TYPE=
RAG_FILTER_KNOWLEDGE_BASE_VERSION=
RAG_INSUFFICIENT_KNOWLEDGE_MESSAGE=知识库资料不足，无法根据现有资料回答。
RAG_HYBRID_SEARCH_ENABLED=false
RAG_HYBRID_VECTOR_WEIGHT=0.7
RAG_HYBRID_KEYWORD_WEIGHT=0.3
RAG_HYBRID_RRF_K=60
RAG_RERANK_ENABLED=false
RAG_RERANK_MODEL_NAME=gte-rerank-v2
RAG_RERANK_MAX_CANDIDATES=10
RAG_RERANK_TIMEOUT_SECONDS=3
RAG_RERANK_MAX_INPUT_TOKENS=12000
RAG_RERANK_INPUT_PRICE_PER_MILLION_TOKENS_CNY=0.8
RAG_RERANK_MAX_ESTIMATED_COST_CNY=0.01
TELEMETRY_ENABLED=true
TELEMETRY_LOG_PATH=./logs/telemetry.jsonl
TELEMETRY_LOG_MAX_BYTES=5242880
TELEMETRY_LOG_BACKUP_COUNT=5
AGENT_ENABLED=false
AGENT_MAX_STEPS=5
AGENT_TOOL_TIMEOUT_SECONDS=30
AGENT_RUN_TIMEOUT_SECONDS=120
AGENT_MAX_TOKENS=12000
AGENT_MAX_ESTIMATED_COST_CNY=0.05
AGENT_INPUT_PRICE_PER_MILLION_TOKENS_CNY=2.5
AGENT_OUTPUT_PRICE_PER_MILLION_TOKENS_CNY=10
AGENT_MODEL_MAX_OUTPUT_TOKENS=1200
