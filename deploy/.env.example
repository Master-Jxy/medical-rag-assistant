# Copy this file to deploy/.env on the server. Never commit real secrets.
COMPOSE_PROJECT_NAME=medical-rag

DASHSCOPE_API_KEY=replace_with_your_dashscope_api_key
JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_characters

# QQ邮箱SMTP授权码不是QQ密码。部署前必须替换用户名与授权码。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=example@qq.com
SMTP_PASSWORD=replace_with_qq_smtp_authorization_code
SMTP_USE_SSL=true
SMTP_TIMEOUT_SECONDS=10
MAIL_FROM_NAME=医疗知识库助手
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5

MYSQL_DATABASE=medical_rag
MYSQL_USER=medical_rag_user
MYSQL_PASSWORD=replace_with_a_strong_database_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_strong_root_password

CHAT_MODEL_NAME=qwen3-max
# 当前Qwen模型的费用估算单价；供应商调价时需要同步更新并重新部署。
CHAT_INPUT_PRICE_PER_MILLION_TOKENS_CNY=2.5
CHAT_OUTPUT_PRICE_PER_MILLION_TOKENS_CNY=10

# Private chat image understanding. Keep automatic provider retries at zero;
# the Agent itself may request at most two focused follow-up observations.
MEDIA_RETENTION_DAYS=30
VISION_CHAT_ENABLED=false
VISION_PROVIDER=dashscope
VISION_MODEL=qwen3-vl-plus
VISION_MAX_IMAGES=3
VISION_MAX_IMAGE_BYTES=10485760
VISION_MAX_IMAGE_PIXELS=40000000
VISION_MAX_CALLS_PER_IMAGE=3
VISION_TIMEOUT_SECONDS=45
VISION_AUTOMATIC_RETRIES=0
VISION_RESERVE_INPUT_TOKENS=2000
VISION_RESERVE_OUTPUT_TOKENS=1000
# Leave prices empty until the current provider price is verified.
VISION_INPUT_PRICE_PER_MILLION_TOKENS_CNY=
VISION_OUTPUT_PRICE_PER_MILLION_TOKENS_CNY=

# Long-term memory extraction and quota enforcement are separate opt-in gates.
# Keep both disabled for the initial phase 17/18 production release.
MEMORY_AUTO_EXTRACTION_ENABLED=false
MEMORY_EXTRACTION_INTERVAL_TURNS=3
MEMORY_RAG_MAX_ITEMS=4
MEMORY_AGENT_MAX_ITEMS=6
QUOTA_POLICY_MODE=off
# Legacy compatibility only; QUOTA_POLICY_MODE takes precedence when set.
QUOTA_ENFORCEMENT_ENABLED=false
DEFAULT_QUOTA_PLAN_CODE=free
QUOTA_RAG_RESERVE_TOKENS=4000
QUOTA_AGENT_RESERVE_TOKENS=12000
QUOTA_RAG_MAX_OUTPUT_TOKENS=2000
QUOTA_RAG_SOURCE_WRAPPER_TOKENS=200

EMBEDDING_MODEL_NAME=text-embedding-v4
DASHSCOPE_MAX_RETRIES=2
CHROMA_COLLECTION_NAME=agent

# Structured telemetry contains only aggregate metrics and safe metadata.
TELEMETRY_ENABLED=true
TELEMETRY_LOG_PATH=/app/data/logs/telemetry.jsonl
TELEMETRY_LOG_MAX_BYTES=5242880
TELEMETRY_LOG_BACKUP_COUNT=5

# Controlled Agent is opt-in. Keep the bounded policy even when enabled.
AGENT_ENABLED=false
AGENT_MAX_STEPS=5
AGENT_TOOL_TIMEOUT_SECONDS=30
AGENT_RUN_TIMEOUT_SECONDS=120
AGENT_MAX_TOKENS=12000
AGENT_MAX_ESTIMATED_COST_CNY=0.05
AGENT_INPUT_PRICE_PER_MILLION_TOKENS_CNY=2.5
AGENT_OUTPUT_PRICE_PER_MILLION_TOKENS_CNY=10
AGENT_MODEL_MAX_OUTPUT_TOKENS=1200

# HTTPS override only. Prefer an owned domain. A public IP certificate is a
# secure fallback, but it is not a formal branded domain.
HTTPS_IDENTIFIER=demo.example.com
ACME_WEBROOT=/var/lib/medical-rag/acme
LETSENCRYPT_DIR=/etc/letsencrypt

